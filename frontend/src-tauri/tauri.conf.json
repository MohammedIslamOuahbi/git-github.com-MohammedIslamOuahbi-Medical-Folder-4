{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ibn Sina Medical Clinic",
  "version": "../package.json",
  "identifier": "com.ibnsina.medicalclinic",
  "mainBinaryName": "ibn-sina-medical-clinic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Ibn Sina Medical Clinic",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "maximized": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["bin/medical-backend-sidecar"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NkNDNjRFM0UyMjc4QUQKUldTdGVDSStUc1pzbWRCNElzelBLUHpBM3ArVFVRZE1SdjVEd1V1dEhSemxIQnpVelNId3FPeCsK",
      "endpoints": ["https://example.com/ibn-sina-medical-clinic/latest.json"]
    }
  }
}
