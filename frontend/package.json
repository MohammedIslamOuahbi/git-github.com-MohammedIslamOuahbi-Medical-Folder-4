{
  "name": "medical-clinic-management-system-frontend",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build --configLoader runner",
    "build:backend": "scripts\\build-backend-sidecar.cmd",
    "build:desktop:web": "tsc --noEmit -p tsconfig.json && cross-env VITE_ROUTER_MODE=hash vite build --configLoader runner",
    "build:desktop": "npm run tauri:build",
    "tauri:check": "scripts\\tauri-check-msvc.cmd",
    "tauri:dev": "scripts\\tauri-dev-msvc.cmd",
    "tauri:build": "scripts\\tauri-build-msvc.cmd",
    "tauri:build:central": "node ./scripts/build-tauri-profile.mjs central",
    "tauri:build:mobile": "node ./scripts/build-tauri-profile.mjs mobile",
    "tauri:keys": "node ./scripts/ensure-tauri-updater-key.mjs",
    "installers:build": "node ./scripts/build-installers.mjs",
    "test:installer-build": "node --test ./scripts/test-installer-profiles.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:setup-flow": "tsc -p tsconfig.tests.json && node --test tmp-tests/pages/auth/setupFlow.test.js tmp-tests/pages/auth/loginConnectionInfo.test.js tmp-tests/services/runtimeConnectionValidationRules.test.js tmp-tests/features/central/centralServerFlow.test.js tmp-tests/features/mobile/mobileDeviceFlow.test.js tmp-tests/features/installation/profileInfrastructure.test.js tmp-tests/features/installation/sidebarNavigation.test.js",
    "test:campaign-options": "tsc -p tsconfig.tests.json && node --test tmp-tests/api/fetchAllPages.test.js",
    "test": "npm run test:setup-flow && npm run test:installer-build && npm run test:campaign-options"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.15.31",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.ibnsina.medicalclinic",
    "productName": "Ibn Sina Medical Clinic",
    "directories": {
      "output": "dist-desktop-fixed"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "app/**/*",
          "venv/**/*",
          "uploads/**/*",
          "run_desktop.py",
          "requirements.txt"
        ]
      }
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ibn Sina Medical Clinic"
    }
  }
}
