APP_ENV=production
DATABASE_URL=postgresql+psycopg://medical_user:admin@127.0.0.1:5432/ibn_sina_recovery_test
PG_DUMP_PATH=
PG_RESTORE_PATH=
POSTGRES_BACKUP_TIMEOUT_SECONDS=600
POSTGRES_RESTORE_VALIDATION_TIMEOUT_SECONDS=120
POSTGRES_RESTORE_TIMEOUT_SECONDS=1800
POSTGRES_ALEMBIC_TIMEOUT_SECONDS=600
API_BASE_URL=http://localhost:8000/api/v1
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_NAME=Medical Clinic Management System

# Tauri and local development frontend origins.
BACKEND_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Production LAN / clinic example:
# DATABASE_URL=postgresql+psycopg://medical_user:strong_password@192.168.1.10:5432/medical_db
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
# API_BASE_URL=http://192.168.1.10:8000/api/v1
# BACKEND_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://192.168.1.10:8000,http://localhost:8000
#
# Alembic reads the same DATABASE_URL through app settings; do not duplicate it in alembic.ini.

# Tests require a separate PostgreSQL database. Never point this at production.
# TEST_DATABASE_URL=postgresql+psycopg://medical_user:strong_password@127.0.0.1:5432/medical_db_test
